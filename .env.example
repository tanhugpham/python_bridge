# Copy to .env. Do not commit .env. Leave secrets empty until you choose them.
BRIDGE_MODE=mock
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_INGEST_KEY=
BRIDGE_READ_KEY=
BRIDGE_SSL_CERT=
BRIDGE_SSL_KEY=

# Mock only. When set, every event the local host page publishes is also copied (batched,
# in the background) to this bridge, which is the one Roblox polls.
# Leave empty to keep events in the local process only. Ignored when BRIDGE_MODE=live.
# Example: BRIDGE_MIRROR_URL=https://python-bridge-6v9w.onrender.com
BRIDGE_MIRROR_URL=
# Defaults to BRIDGE_INGEST_KEY of this file when empty.
BRIDGE_MIRROR_INGEST_KEY=

# Durable state (Phase 9H). The queue journal keeps pending rows, dedup ids, the ack
# history and the session id across a restart. The mirror outbox keeps every produced
# event until the queue reports it acked. Relative paths resolve from the package root.
# Set BRIDGE_JOURNAL_PATH= to disable the journal and keep the queue in memory.
BRIDGE_JOURNAL_PATH=data/queue-journal.sqlite3
BRIDGE_OUTBOX_PATH=data/mirror-outbox.sqlite3
# Seconds after which an unacked outbox row is dropped to bound storage. 0 disables it.
BRIDGE_OUTBOX_TTL=1800

# Live mode only. This project does not connect until you set BRIDGE_MODE=live.
TIKTOK_USERNAME=
# Username-only is the supported default: leave both session variables empty and the
# listener joins the room anonymously. A session is only for a manual, whitelisted
# sign server; never point this bridge at a shared one, and never send a broadcaster
# session to TikTok's own sign server (that is the ban path).
TIKTOK_SESSION_ID=
TIKTOK_TARGET_IDC=
# Optional room id override (digits only). When set, the first connection skips the
# HTML room scrape that TikTok rate-limits, which is what produces JSONDecodeError.
# The bridge learns the id from the first successful connection, so this is only
# needed after a cold start on a host TikTok already throttles.
TIKTOK_ROOM_ID=
